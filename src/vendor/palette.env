# The Nerv palette — OneDark. THE source of truth; nothing else may restate a hex value.
#
# Sourced by shells, read by the generators that emit each tool's own colour syntax, and
# checked by tools/lint-theme.sh, which fails the build if a colour-capable package we ship
# has no entry in THEME-MANIFEST.
#
# Twelve roles. A tool that needs a thirteenth is telling us the palette is wrong, not that
# it needs a private colour — add it here, never in the consumer.
NERV_FG=abb2bf
NERV_BLUE=61afef
NERV_GREEN=98c379
NERV_CYAN=56b6c2
NERV_YELLOW=e5c07b
NERV_ORANGE=d19a66
NERV_RED=e06c75
NERV_MAGENTA=c678dd
NERV_GRAY=5c6370
NERV_VISUAL=3e4451
# The background. tmux's generate-fmt.sh reached for this and had to invent it; so did
# fastfetch. A role the palette lacks is a role a consumer will make up.
NERV_BG=282c34
# Dim text on a coloured bar — the one role that is not a stock OneDark slot. It exists
# because the tmux session bar needs a foreground legible on NERV_BLUE.
NERV_ON_BLUE=1a3a52
